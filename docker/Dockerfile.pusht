# Minimal environment for the Diffusion Policy Push-T low-dimensional workflow.
# This deliberately excludes MuJoCo, robosuite, PyTorch3D, real robots, and
# image Push-T extras. Those belong in a later, separately reviewed image.
ARG BASE_IMAGE=nvidia/cuda:12.4.0-base-ubuntu22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYGAME_HIDE_SUPPORT_PROMPT=1 \
    SDL_VIDEODRIVER=dummy \
    PATH=/opt/dp-venv/bin:${PATH}

COPY docker/install_pusht_env.sh docker/requirements-pusht.txt /opt/dp-bootstrap/
RUN bash /opt/dp-bootstrap/install_pusht_env.sh

WORKDIR /workspace/code
CMD ["/bin/bash"]
